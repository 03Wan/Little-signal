.screen { box-sizing: border-box; min-height: 100vh; padding: calc(env(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-5)); background: var(--color-bg); color: var(--color-text-primary); }
.info-page__header { display: flex; height: var(--size-hit-target); align-items: center; justify-content: space-between; }
.info-page__back, .info-page__spacer { display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-display); }
.info-page__title { font-size: var(--font-size-body); font-weight: var(--font-weight-medium); }
.info-page__symbol { display: flex; width: 72px; height: 72px; align-items: center; justify-content: center; margin: var(--space-12) auto var(--space-4); border-radius: var(--radius-pill); background: var(--color-surface); color: var(--color-signal-core); font-size: 36px; }
.info-page__lead { display: block; margin-bottom: var(--space-5); text-align: center; font-size: var(--font-size-h2); font-weight: var(--font-weight-medium); }
.info-page__card { padding: var(--space-5); border: var(--border-width-thin) solid var(--color-border-subtle); border-radius: var(--radius-card); background: var(--color-surface); }
.info-page__copy { display: block; color: var(--color-text-secondary); font-size: var(--font-size-secondary); line-height: var(--line-height-body); }
.info-page__divider { height: 1px; margin: var(--space-4) 0; background: var(--color-divider); }
