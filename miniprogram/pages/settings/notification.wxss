.screen { box-sizing: border-box; min-height: 100vh; padding: calc(constant(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(constant(safe-area-inset-bottom) + var(--space-5)); padding: calc(env(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-5)); background: var(--color-bg); color: var(--color-text-primary); }
.notification-settings__header { display: flex; height: var(--size-hit-target); align-items: center; justify-content: space-between; }
.notification-settings__back, .notification-settings__spacer { display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-display); }
.notification-settings__title { font-size: var(--font-size-body); font-weight: var(--font-weight-medium); line-height: var(--line-height-body); }
.notification-settings__content { transition: opacity var(--duration-micro) var(--ease-standard); }
.notification-settings__content--saving { opacity: .72; }
.notification-settings__group { margin-top: var(--space-4); padding: 0 var(--space-4); border: var(--border-width-thin) solid var(--color-border-subtle); border-radius: var(--radius-card); background: var(--color-surface); }
.notification-settings__row { display: flex; min-height: var(--space-16); align-items: center; justify-content: space-between; gap: var(--space-3); border-bottom: var(--border-width-thin) solid var(--color-divider); }
.notification-settings__row:last-child { border-bottom: 0; }
.notification-settings__row-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--space-1); }
.notification-settings__label { font-size: var(--font-size-body); line-height: var(--line-height-body); }
.notification-settings__description { color: var(--color-text-tertiary); font-size: var(--font-size-caption); line-height: var(--line-height-caption); }
.notification-settings__toggle { display: flex; box-sizing: border-box; width: var(--space-12); height: var(--space-8); flex: none; align-items: center; padding: var(--space-1); border: var(--border-width-thin) solid var(--color-divider); border-radius: var(--radius-pill); background: var(--color-bg); transition: background-color var(--duration-micro) var(--ease-standard); }
.notification-settings__toggle--on { justify-content: flex-end; border-color: var(--color-text-primary); background: var(--color-text-primary); }
.notification-settings__thumb { width: var(--space-5); height: var(--space-5); border-radius: var(--radius-pill); background: var(--color-surface); box-shadow: var(--shadow-card); }
.notification-settings__quiet-group { margin-top: var(--space-4); }
.notification-settings__quiet-row { border-bottom: 0; }
.notification-settings__times { border-top: var(--border-width-thin) solid var(--color-divider); }
.notification-settings__time-picker { display: block; }
.notification-settings__time-row { display: flex; min-height: var(--size-button-height); align-items: center; border-bottom: var(--border-width-thin) solid var(--color-divider); }
.notification-settings__time-picker:last-child .notification-settings__time-row { border-bottom: 0; }
.notification-settings__time-label { flex: 1; color: var(--color-text-secondary); font-size: var(--font-size-secondary); }
.notification-settings__time-value { margin-right: var(--space-2); color: var(--color-text-primary); font-size: var(--font-size-secondary); font-variant-numeric: tabular-nums; }
.notification-settings__arrow { color: var(--color-text-tertiary); font-size: var(--font-size-h2); }
.notification-settings__note { display: block; margin: var(--space-4) var(--space-4) 0; color: var(--color-text-tertiary); font-size: var(--font-size-caption); line-height: var(--line-height-caption); }
.notification-settings__state { display: flex; min-height: 55vh; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--font-size-secondary); }
.notification-settings__retry { color: var(--color-text-primary); }
