.screen { box-sizing: border-box; min-height: 100vh; padding: calc(env(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-5)); background: var(--color-bg); color: var(--color-text-primary); }
.settings-page__header { display: flex; height: var(--size-hit-target); align-items: center; justify-content: space-between; }
.settings-page__back, .settings-page__spacer { display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-display); }
.settings-page__title { font-size: var(--font-size-body); font-weight: var(--font-weight-medium); }
.settings-page__group { margin-top: var(--space-4); padding: 0 var(--space-4); border: var(--border-width-thin) solid var(--color-border-subtle); border-radius: var(--radius-card); background: var(--color-surface); }
.settings-page__row { display: flex; min-height: var(--size-button-height); align-items: center; justify-content: space-between; border-bottom: var(--border-width-thin) solid var(--color-divider); color: var(--color-text-secondary); font-size: var(--font-size-secondary); }
.settings-page__row:last-child { border-bottom: 0; }
.settings-page__arrow { color: var(--color-text-tertiary); font-size: var(--font-size-h2); }
