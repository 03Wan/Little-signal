.screen { box-sizing: border-box; min-height: 100vh; padding: calc(constant(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(constant(safe-area-inset-bottom) + var(--space-5)); padding: calc(env(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-5)); background: var(--color-bg); color: var(--color-text-primary); }
