<view class="screen screen--tab us-page" style="padding-top: {{pageTopPadding}}px">
  <view class="us-page__title">我们</view>
  <view class="us-page__relationship">
    <view class="us-page__orbs" aria-hidden="true"><view class="us-page__orb us-page__orb--one" /><view class="us-page__orb us-page__orb--two" /></view>
    <view class="us-page__names"><text>{{firstName}}</text><text class="us-page__times">×</text><text>{{partnerName}}</text></view>
    <text class="us-page__days">第 {{days}} 天</text>
  </view>

  <view class="us-page__collections">
    <view class="us-page__collection" bindtap="openCustomSignals">
      <view class="us-page__collection-symbol us-page__collection-symbol--warm">🌻</view>
      <text class="us-page__collection-name">我们的暗号</text>
      <text class="us-page__collection-count">{{secretCount}}</text>
    </view>
    <view class="us-page__collection" bindtap="openCapsules">
      <view class="us-page__collection-symbol">◌</view>
      <text class="us-page__collection-name">时光胶囊</text>
      <text class="us-page__collection-count">{{capsuleCount}}</text>
    </view>
  </view>

  <view class="us-page__links">
    <view class="us-page__link" bindtap="openNotificationSettings"><text>通知与勿扰</text><text class="us-page__arrow">›</text></view>
    <view class="us-page__link" bindtap="openPrivacy"><text>隐私设置</text><text class="us-page__arrow">›</text></view>
    <view class="us-page__link" bindtap="openRelationshipSettings"><text>关系设置</text><text class="us-page__arrow">›</text></view>
    <view class="us-page__link" bindtap="openAbout"><text>关于小信号</text><text class="us-page__arrow">›</text></view>
  </view>
</view>
