.us-page__orb { position: absolute; top: 0; width: var(--space-12); height: var(--space-12); border: var(--border-width-thin) solid var(--color-border-subtle); border-radius: var(--radius-pill); box-shadow: var(--shadow-orb); }
.us-page__orb--one { left: var(--space-2); background: radial-gradient(circle at 38% 36%, var(--color-surface-elevated), var(--color-signal-core)); }
.us-page__orb--two { right: var(--space-2); background: radial-gradient(circle at 38% 36%, var(--color-surface-elevated), var(--color-signal-blue)); }
.us-page__names { display: flex; align-items: center; margin-top: var(--space-3); font-size: var(--font-size-body); line-height: var(--line-height-body); }
.us-page__times { margin: 0 var(--space-3); color: var(--color-text-tertiary); }
.us-page__days { margin-top: var(--space-2); color: var(--color-text-secondary); font-size: var(--font-size-secondary); font-variant-numeric: tabular-nums; line-height: var(--line-height-secondary); }
