.mood-page { display: flex; box-sizing: border-box; min-height: 100vh; flex-direction: column; padding: calc(constant(safe-area-inset-top) + var(--space-3)) var(--space-page) calc(constant(safe-area-inset-bottom) + var(--space-4)); padding: calc(env(safe-area-inset-top) + var(--space-3)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-4)); background: var(--color-bg); color: var(--color-text-primary); }
.mood-page__top { display: flex; height: var(--size-hit-target); align-items: center; justify-content: space-between; }
.mood-page__back, .mood-page__top-spacer { width: var(--size-hit-target); }
.mood-page__back { color: var(--color-text-secondary); font-size: var(--font-size-h1); line-height: var(--line-height-h1); }
.mood-page__title { font-size: var(--font-size-body); font-weight: var(--font-weight-medium); line-height: var(--line-height-body); }
.mood-page__options { margin-top: var(--space-6); }
.mood-page__option { display: flex; min-height: 64px; align-items: center; border-bottom: var(--border-width-thin) solid var(--color-divider); transition: transform var(--duration-micro) var(--ease-standard), opacity var(--duration-micro) var(--ease-standard); }
.mood-page__option--selected { transform: scale(.985); }
.mood-page__option--disabled, .mood-page__clear--disabled { opacity: .55; }
.mood-page__icon { display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-h1); }
.mood-page__option--great .mood-page__icon { color: var(--color-mood-happy); }
.mood-page__option--okay .mood-page__icon { color: var(--color-mood-okay); }
.mood-page__option--tired .mood-page__icon { color: var(--color-mood-tired); }
.mood-page__option--sad .mood-page__icon { color: var(--color-mood-sad); }
.mood-page__option--quiet .mood-page__icon { color: var(--color-mood-quiet); }
.mood-page__label { flex: 1; padding-left: var(--space-2); font-size: var(--font-size-body); line-height: var(--line-height-body); }
.mood-page__check { display: flex; width: var(--space-5); height: var(--space-5); align-items: center; justify-content: center; border: var(--border-width-thin) solid var(--color-divider); border-radius: var(--radius-pill); color: var(--color-on-primary); font-size: var(--font-size-caption); }
.mood-page__option--selected .mood-page__check { border-color: var(--color-text-primary); background: var(--color-text-primary); }
.mood-page__clear { display: flex; min-height: var(--size-hit-target); align-items: center; justify-content: center; margin-top: var(--space-3); color: var(--color-text-secondary); font-size: var(--font-size-secondary); }
.mood-page__option--custom .mood-page__icon { color: var(--color-signal-core); }
.mood-page__custom-sheet { display: flex; flex-direction: column; align-items: stretch; }
.mood-page__custom-input { box-sizing: border-box; height: var(--size-button-height); margin-bottom: var(--space-2); padding: 0 var(--space-3); border: var(--border-width-thin) solid var(--color-border-subtle); border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text-primary); font-size: var(--font-size-body); }
.mood-page__custom-hint { margin-bottom: var(--space-4); color: var(--color-text-tertiary); font-size: var(--font-size-caption); }
.mood-page__custom-cancel { align-self: center; margin-top: var(--space-3); padding: var(--space-2) var(--space-5); color: var(--color-text-tertiary); font-size: var(--font-size-secondary); }
@media (max-height: 700px) { .mood-page { padding-top:var(--space-1); padding-bottom:var(--space-2); } .mood-page__top { height:36px; flex:none; } .mood-page__options { margin-top:var(--space-2); } .mood-page__option { min-height:44px; } .mood-page__icon { height:40px; } .mood-page__clear { min-height:36px; margin-top:var(--space-1); } }
