<view wx:if="{{authorized}}" class="preview theme-{{theme}}">
  <view class="preview__dev" wx:if="{{devBadge}}"><text>DEV · UI REVIEW</text><text class="preview__dev-close" bindtap="closeBadge">×</text></view>
  <view class="preview__meta"><text class="preview__title">{{item.title}}</text><text class="preview__english">{{item.english}} · {{item.page}}</text></view>
  <view class="preview__theme"><text data-theme="light" bindtap="selectTheme">Light</text><text data-theme="dark" bindtap="selectTheme">Dark</text><text data-theme="system" bindtap="selectTheme">System</text></view>
  <view class="preview__screen">
    <view wx:if="{{isSplash}}" class="splash"><view class="splash__orb"><view /></view><text class="splash__brand">小 信 号</text><text class="splash__line">有些时候，不是想聊天</text><text class="splash__line">只是突然想到了一个人</text><view class="splash__button">开始使用</view><text class="splash__privacy">已阅读并同意隐私说明</text></view>
    <view wx:if="{{isHome}}" class="home-preview"><text class="home-preview__settings">⚙</text><text class="home-preview__partner">{{mock.partner}}</text><text class="home-preview__mood">{{mock.mood}}</text><view class="home-preview__orb"><view>◉</view></view><text class="home-preview__action">发个信号</text><text class="home-preview__hint">轻触 · 双击都可以</text><view wx:if="{{showHomeOffline}}" class="preview-state preview-state--error">当前网络不可用</view><view wx:if="{{showHomeIncoming}}" class="preview-state">有一个信号等你接住</view><view wx:if="{{showHomeResponded}}" class="preview-state">她接住了你的信号</view><text class="home-preview__context">今天留下了 3 个瞬间</text><view class="preview-tab"><text>信号</text><text>足迹</text><text>我们</text></view></view>
    <view wx:if="{{isSignal}}" class="signal-preview"><text class="signal-preview__sender">王波 的信号</text><view class="signal-preview__orb">◉</view><text class="signal-preview__message">{{mock.message}}</text><text class="signal-preview__time">今天 01:37</text><view wx:if="{{isNoReply}}" class="signal-preview__note">不用回复</view><view wx:if="{{isResponded}}" class="signal-preview__note">已回应：接住了</view><view wx:if="{{showResponseActions}}" class="signal-preview__actions"><view>接住了</view><view>我也在</view><view>抱一下</view><text>稍后回应</text></view></view>
    <view wx:if="{{isStar}}" class="star-preview"><text class="star-preview__month">September 2026</text><text class="star-preview__count">{{mock.count}} 个小信号</text><view class="star-preview__sky"><view wx:for="{{mock.points}}" wx:key="x" class="star-preview__point star-preview__point--{{item.tone}}" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.size}}px;height:{{item.size}}px" /></view><text class="star-preview__link">看时间轴　→</text></view>
    <view wx:if="{{isTimeline}}" class="timeline-preview"><text class="timeline-preview__heading">我们的足迹</text><view wx:if="{{showTimelineEmpty}}" class="timeline-preview__empty">还没有留下信号</view><view wx:if="{{showTimelineRecords}}"><view wx:for="{{mock.records}}" wx:key="time" class="timeline-preview__row"><view class="timeline-preview__dot"/><view><text class="timeline-preview__date">{{item.date}} · {{item.time}}</text><text class="timeline-preview__record">{{item.title}}</text><text class="timeline-preview__subtitle">{{item.subtitle}}</text></view></view></view></view>
    <view wx:if="{{isUs}}" class="us-preview"><text class="us-preview__title">我们</text><view class="us-preview__pair">王波　×　姚闻月</view><text class="us-preview__days">认识第 184 天</text><view class="us-preview__card">我们的暗号　　7 个</view><view class="us-preview__card">时光胶囊　　3 个</view><view class="us-preview__card">通知与勿扰　›</view><view class="us-preview__card">隐私设置　　›</view><view class="us-preview__card">关系设置　　›</view></view>
    <view wx:if="{{isGeneric}}" class="generic-preview"><view class="generic-preview__orb">◉</view><text class="generic-preview__message">{{mock.message}}</text><text class="generic-preview__detail">{{mock.detail}}</text><view wx:if="{{isCapsule}}" class="generic-preview__capsule"><text>◌</text><text>{{mock.status === 'unlocked' ? '可以打开了' : mock.detail}}</text></view><view wx:if="{{showGenericAction}}" class="generic-preview__button">{{mock.status === 'error' ? '再试一次' : '了解更多'}}</view></view>
  </view>
  <view class="preview__footer"><text>{{item.state}}</text><text bindtap="goReview">‹ 返回 UI Review</text></view>
</view>
