.preview { min-height:100vh; box-sizing:border-box; padding:12px 20px 30px; background:var(--color-bg); color:var(--color-text-primary); }
.preview.theme-light { --color-bg:#F7F7F5; --color-surface:#FFFFFF; --color-surface-elevated:#FCFCFA; --color-text-primary:#171717; --color-text-secondary:#72726E; --color-text-tertiary:#A4A49F; --color-divider:#E8E8E4; }
.preview.theme-dark { --color-bg:#111111; --color-surface:#1A1A1A; --color-surface-elevated:#222222; --color-text-primary:#F4F4F2; --color-text-secondary:#A8A8A2; --color-text-tertiary:#858580; --color-divider:#2E2E2C; }
.preview__dev { display:flex; justify-content:space-between; align-items:center; margin:0 -4px 14px; color:var(--color-text-tertiary); font-size:10px; letter-spacing:1px; }
.preview__dev-close { padding:6px 9px; border-radius:999px; background:var(--color-surface); letter-spacing:0; }
.preview__meta { display:flex; flex-direction:column; gap:3px; margin-bottom:12px; }
.preview__title { font-size:21px; font-weight:600; }
.preview__english { color:var(--color-text-tertiary); font-size:10px; }
.preview__theme { display:flex; gap:8px; margin-bottom:14px; color:var(--color-text-secondary); font-size:11px; }
.preview__theme text { padding:5px 10px; border:1px solid var(--color-divider); border-radius:999px; }
.preview__screen { min-height:70vh; overflow:hidden; border:1px solid var(--color-divider); border-radius:24px; background:var(--color-bg); }
.preview__footer { display:flex; justify-content:space-between; gap:12px; padding:14px 3px; color:var(--color-text-tertiary); font-size:11px; }
.splash { min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:28px; box-sizing:border-box; }
.splash__orb,.home-preview__orb,.signal-preview__orb,.generic-preview__orb { display:flex; align-items:center; justify-content:center; border-radius:50%; background:radial-gradient(circle,#fff 0%,#eeeaff 38%,#ffe8cf 75%,transparent 100%); color:#9b91c6; }
.splash__orb { width:150px; height:150px; margin-bottom:36px; }.splash__orb view { width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 0 28px #cbc1ff; }
.splash__brand { margin-bottom:16px; font-size:24px; letter-spacing:5px; }.splash__line { color:var(--color-text-secondary); font-size:13px; line-height:23px; }.splash__button { width:100%; margin-top:70px; padding:14px; border-radius:999px; background:var(--color-text-primary); color:var(--color-bg); text-align:center; }.splash__privacy { margin-top:12px;color:var(--color-text-tertiary);font-size:10px; }
.home-preview { display:flex; min-height:70vh; flex-direction:column; align-items:center; padding:22px 20px 14px; box-sizing:border-box; }.home-preview__settings { align-self:flex-end; color:var(--color-text-secondary); }.home-preview__partner { margin-top:35px;font-size:22px;font-weight:500; }.home-preview__mood { margin-top:8px;color:var(--color-text-secondary);font-size:13px; }.home-preview__orb { width:164px;height:164px;margin-top:48px; }.home-preview__orb view { font-size:35px; }.home-preview__action { margin-top:12px;font-size:16px; }.home-preview__hint,.home-preview__context { margin-top:5px;color:var(--color-text-tertiary);font-size:11px; }.home-preview__context { margin-top:auto;padding:20px 0; }.preview-tab { display:flex;width:100%;justify-content:space-around;padding:12px 0 4px;border-top:1px solid var(--color-divider);color:var(--color-text-secondary);font-size:11px; }.preview-state { margin-top:13px;padding:9px 13px;border-radius:12px;background:var(--color-surface);font-size:12px; }.preview-state--error { color:#c77967; }
.signal-preview { display:flex;min-height:70vh;flex-direction:column;align-items:center;padding:28px 24px;box-sizing:border-box; }.signal-preview__sender { align-self:flex-start;color:var(--color-text-secondary);font-size:13px; }.signal-preview__orb { width:128px;height:128px;margin:85px 0 26px;font-size:32px; }.signal-preview__message { font-size:19px; }.signal-preview__time { margin-top:10px;color:var(--color-text-tertiary);font-size:11px; }.signal-preview__actions { display:flex;width:100%;flex-direction:column;gap:9px;margin-top:auto;padding-top:44px; }.signal-preview__actions view { padding:12px;border-radius:999px;background:var(--color-surface);text-align:center;font-size:13px; }.signal-preview__actions text,.signal-preview__note { margin-top:14px;color:var(--color-text-secondary);font-size:12px; }.signal-preview__note { margin-top:68px; }
.star-preview { padding:28px 22px; }.star-preview__month,.star-preview__count { display:block;text-align:center; }.star-preview__month {font-size:19px;}.star-preview__count {margin-top:5px;color:var(--color-text-tertiary);font-size:11px;}.star-preview__sky { position:relative;height:390px;margin-top:16px;border-radius:22px;background:radial-gradient(ellipse at center,rgba(202,194,255,.10),transparent 66%); }.star-preview__point { position:absolute;border-radius:50%;background:#d9d2ff;box-shadow:0 0 10px #d9d2ff; }.star-preview__point--warm {background:#f3d4aa;box-shadow:0 0 9px #f3d4aa;}.star-preview__point--blue {background:#c7d9f4;box-shadow:0 0 8px #c7d9f4;}.star-preview__link {display:block;text-align:center;color:var(--color-text-secondary);font-size:12px;}
.timeline-preview,.us-preview { padding:26px 22px; }.timeline-preview__heading,.us-preview__title {display:block;margin-bottom:23px;font-size:21px;}.timeline-preview__row {display:flex;gap:13px;padding:0 0 23px;}.timeline-preview__dot {width:8px;height:8px;margin:5px 0 0 3px;border-radius:50%;background:#d9d2ff;box-shadow:0 0 7px #d9d2ff;}.timeline-preview__row view:last-child {display:flex;flex-direction:column;gap:3px;}.timeline-preview__date,.timeline-preview__subtitle {color:var(--color-text-tertiary);font-size:10px;}.timeline-preview__record {font-size:14px;}.timeline-preview__empty {padding:80px 0;text-align:center;color:var(--color-text-secondary);font-size:13px;}.us-preview__pair {margin:38px 0 5px;text-align:center;font-size:20px;}.us-preview__days {display:block;margin-bottom:30px;text-align:center;color:var(--color-text-tertiary);font-size:11px;}.us-preview__card {margin:9px 0;padding:16px;border:1px solid var(--color-divider);border-radius:16px;background:var(--color-surface);font-size:13px;}
.generic-preview { display:flex;min-height:70vh;flex-direction:column;align-items:center;justify-content:center;padding:28px;box-sizing:border-box;text-align:center; }.generic-preview__orb {width:94px;height:94px;margin-bottom:24px;font-size:26px;}.generic-preview__message {font-size:18px;}.generic-preview__detail {max-width:240px;margin-top:12px;color:var(--color-text-secondary);font-size:12px;line-height:1.8;}.generic-preview__capsule {display:flex;flex-direction:column;gap:14px;margin-top:36px;padding:28px 40px;border:1px solid var(--color-divider);border-radius:20px;background:var(--color-surface);font-size:13px;}.generic-preview__capsule text:first-child {font-size:28px;color:#baacde;}.generic-preview__button {margin-top:28px;padding:12px 45px;border-radius:999px;background:var(--color-text-primary);color:var(--color-bg);font-size:13px;}
