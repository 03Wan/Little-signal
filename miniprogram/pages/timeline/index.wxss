.screen { box-sizing: border-box; min-height: 100vh; padding: calc(constant(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(constant(safe-area-inset-bottom) + var(--space-6)); padding: calc(env(safe-area-inset-top) + var(--space-2)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-6)); background: var(--color-bg); color: var(--color-text-primary); }
.timeline__header { display: flex; height: var(--size-hit-target); align-items: center; justify-content: space-between; }
.timeline__back { display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-display); line-height: var(--line-height-display); }
.timeline__title { font-size: var(--font-size-h2); font-weight: var(--font-weight-semibold); line-height: var(--line-height-h2); }
.timeline__header-space { width: var(--size-hit-target); }
.timeline__list { padding-top: var(--space-4); }
.timeline__date { margin: var(--space-4) 0 var(--space-2) calc(var(--space-8) + var(--space-4)); color: var(--color-text-secondary); font-size: var(--font-size-secondary); font-weight: var(--font-weight-medium); line-height: var(--line-height-secondary); }
.timeline__entry:first-child .timeline__date { margin-top: var(--space-2); }
.timeline__row { display: flex; min-height: var(--space-16); }
.timeline__time-and-icon { display: flex; width: calc(var(--space-8) + var(--space-4)); flex: none; flex-direction: column; align-items: flex-start; }
.timeline__time { color: var(--color-text-tertiary); font-size: var(--font-size-caption); font-variant-numeric: tabular-nums; line-height: var(--line-height-caption); }
.timeline__icon { margin-top: var(--space-2); color: var(--color-text-primary); font-size: var(--font-size-h2); line-height: var(--line-height-h2); }
.timeline__track { position: relative; display: flex; width: var(--space-4); flex: none; justify-content: center; margin-right: var(--space-3); }
.timeline__dot { z-index: 1; width: var(--space-2); height: var(--space-2); margin-top: var(--space-2); border-radius: var(--radius-pill); background: var(--color-signal-core); box-shadow: var(--shadow-orb); }
.timeline__line { position: absolute; top: var(--space-4); bottom: 0; width: var(--border-width-thin); background: var(--color-divider); }
.timeline__description { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: 0 0 var(--space-5); }
.timeline__sentence { display: flex; flex-wrap: wrap; align-items: baseline; font-size: var(--font-size-body); line-height: var(--line-height-body); }
.timeline__sender { font-weight: var(--font-weight-medium); }
.timeline__separator { margin: 0 var(--space-1); color: var(--color-text-tertiary); }
.timeline__response { margin-top: var(--space-1); color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--line-height-caption); }
.timeline__footer, .timeline__state { display: flex; min-height: var(--size-hit-target); align-items: center; justify-content: center; color: var(--color-text-tertiary); font-size: var(--font-size-caption); line-height: var(--line-height-caption); }
.timeline__state { min-height: 45vh; flex-direction: column; gap: var(--space-3); font-size: var(--font-size-secondary); }
.timeline__retry { color: var(--color-text-secondary); }
