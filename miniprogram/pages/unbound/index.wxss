.unbound-page { display: flex; box-sizing: border-box; min-height: 100vh; flex-direction: column; align-items: center; justify-content: center; padding: calc(env(safe-area-inset-top) + var(--space-8)) var(--space-page) calc(env(safe-area-inset-bottom) + var(--space-8)); background: var(--color-bg); color: var(--color-text-primary); text-align: center; }
.unbound-page__symbol { margin-bottom: var(--space-4); color: var(--color-text-tertiary); font-size: 56px; line-height: 1.2; }
.unbound-page__title { font-size: var(--font-size-h2); font-weight: var(--font-weight-semibold); line-height: var(--line-height-h2); }
.unbound-page__description { margin: var(--space-3) 0 var(--space-6); color: var(--color-text-secondary); font-size: var(--font-size-secondary); line-height: var(--line-height-secondary); white-space: pre-line; }
.unbound-page primary-button { width: 100%; }
