<view class="tabbar" role="tablist">
  <view class="tabbar__item {{selectedKey === 'signal' ? 'tabbar__item--selected' : ''}}" data-key="signal" bindtap="handleTabTap" role="tab" aria-selected="{{selectedKey === 'signal'}}">
    <view class="tabbar__icon"><signal-icon name="signal" size="24" label="信号" /></view><text>信号</text>
  </view>
  <view class="tabbar__item {{selectedKey === 'footprints' ? 'tabbar__item--selected' : ''}}" data-key="footprints" bindtap="handleTabTap" role="tab" aria-selected="{{selectedKey === 'footprints'}}">
    <view class="tabbar__icon"><signal-icon name="footprints" size="20" label="足迹" /></view><text>足迹</text>
  </view>
  <view class="tabbar__item {{selectedKey === 'us' ? 'tabbar__item--selected' : ''}}" data-key="us" bindtap="handleTabTap" role="tab" aria-selected="{{selectedKey === 'us'}}">
    <view class="tabbar__icon"><signal-icon name="relation" size="20" label="我们" /></view><text>我们</text>
  </view>
</view>
