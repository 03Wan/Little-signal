.tabbar { position: fixed; z-index: 100; right: var(--space-page, 20px); bottom: 12px; bottom: calc(constant(safe-area-inset-bottom) + 12px); bottom: calc(env(safe-area-inset-bottom) + 12px); left: var(--space-page, 20px); display: flex; box-sizing: border-box; height: var(--size-tabbar-height, 56px); overflow: hidden; border: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.04)); border-radius: var(--radius-lg, 24px); background: var(--color-surface, #FFFFFF); box-shadow: var(--shadow-card, 0 8px 30px rgba(0, 0, 0, 0.04)); }
.tabbar__item { display: flex; min-width: var(--size-hit-target, 44px); min-height: var(--size-hit-target, 44px); flex: 1; flex-direction: column; align-items: center; justify-content: center; color: var(--color-tab-unselected, #A4A49F); font-size: var(--font-size-caption, 12px); line-height: var(--line-height-caption, 18px); transition: color var(--duration-micro, 120ms) var(--ease-standard, ease); }
.tabbar__icon { margin-bottom: var(--space-1, 4px); }
.tabbar__item--selected { color: var(--color-tab-selected, #171717); font-weight: var(--font-weight-medium, 500); }
