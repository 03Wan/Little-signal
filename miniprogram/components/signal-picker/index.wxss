.signal-picker-scene { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; background: var(--color-send-sky); }
.signal-picker__sky { position: relative; min-height: 0; flex: 1; background: radial-gradient(circle at 50% 60%, #414141, var(--color-send-sky) 75%); }
.signal-picker__close { position: absolute; z-index: 2; left: var(--space-page); display: flex; width: var(--size-hit-target); height: var(--size-hit-target); align-items: center; justify-content: center; color: var(--color-text-on-overlay); font-size: var(--font-size-h1); }
.signal-picker__wheel { position: absolute; right: 0; bottom: 0; left: 0; }
.signal-picker__orbit-item { position: absolute; display: flex; box-sizing: border-box; width: 76px; height: 76px; flex-direction: column; align-items: center; justify-content: center; border: var(--border-width-thin) solid var(--color-send-chip-border); border-radius: var(--radius-pill); background: var(--color-send-chip); color: var(--color-text-on-overlay); transform: translate(-50%, -50%); }
.signal-picker__orbit-icon { font-size: var(--font-size-h2); line-height: var(--line-height-h2); }
.signal-picker__orbit-label { margin-top: var(--space-1); font-size: var(--font-size-caption); line-height: var(--line-height-caption); white-space: nowrap; }
.signal-picker__orbit-item--goodnight { top: 14%; left: 50%; }
.signal-picker__orbit-item--tired { top: 37%; left: 22%; }
.signal-picker__orbit-item--hug { top: 37%; left: 78%; }
.signal-picker__orbit-item--home { top: 71%; left: 20%; }
.signal-picker__orbit-item--happy { top: 71%; left: 80%; }
.signal-picker__orbit-item--knock { top: 90%; left: 50%; }
.signal-picker__center-signal { position: absolute; top: 55%; left: 50%; display: flex; flex-direction: column; align-items: center; color: var(--color-text-on-overlay); font-size: var(--font-size-caption); transform: translate(-50%, -50%); }
.signal-picker__center-orb { width: 72px; height: 72px; margin-bottom: var(--space-2); border: var(--border-width-thin) solid rgba(255,255,255,.35); border-radius: var(--radius-pill); background: radial-gradient(circle at 40% 37%, var(--color-surface-elevated), var(--color-signal-core) 47%, #8A85A8); box-shadow: 0 0 28px rgba(217,210,255,.35); }
.signal-picker__sheet { position: relative; display: flex; box-sizing: border-box; height: 56vh; min-height: 350px; max-height: 530px; flex: none; flex-direction: column; overflow: hidden; padding: var(--space-3) var(--space-5) calc(env(safe-area-inset-bottom) + var(--space-3)); border-radius: var(--radius-sheet) var(--radius-sheet) 0 0; background: var(--color-surface); color: var(--color-text-primary); }
.signal-picker__handle { width: var(--size-sheet-handle-width); height: var(--size-sheet-handle-height); flex: none; margin: 0 auto var(--space-4); border-radius: var(--radius-pill); background: var(--color-text-tertiary); opacity: .55; }
.signal-picker__title { flex: none; margin-bottom: var(--space-3); font-size: var(--font-size-body); font-weight: var(--font-weight-medium); line-height: var(--line-height-body); }
.signal-picker__scroll { height: 0; min-height: 0; flex: 1; scrollbar-width: none; }
.signal-picker__item { display: flex; min-height: 42px; align-items: center; color: var(--color-text-primary); font-size: var(--font-size-secondary); line-height: var(--line-height-secondary); }
.signal-picker__icon { display: flex; width: var(--space-8); height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-body); }
.signal-picker__divider { height: var(--border-width-thin); margin: var(--space-1) 0; background: var(--color-divider); }
.signal-picker__no-reply, .signal-picker__moment { display: flex; min-height: var(--size-hit-target); align-items: center; color: var(--color-text-secondary); font-size: var(--font-size-secondary); line-height: var(--line-height-secondary); }
.signal-picker__checkbox { display: flex; box-sizing: border-box; width: var(--space-4); height: var(--space-4); align-items: center; justify-content: center; margin-right: var(--space-3); border: var(--border-width-thin) solid var(--color-border-button); border-radius: var(--space-1); color: var(--color-on-primary); font-size: var(--font-size-caption); }
.signal-picker__checkbox--checked { border-color: var(--color-text-primary); background: var(--color-text-primary); }
.signal-picker__moment-icon { width: var(--space-8); color: var(--color-text-primary); font-size: var(--font-size-h2); }
@media (max-height: 700px) { .signal-picker__orbit-item { width: 60px; height: 60px; } .signal-picker__orbit-icon { font-size: var(--font-size-body); } .signal-picker__orbit-label { font-size: 11px; } .signal-picker__center-orb { width: 58px; height: 58px; } .signal-picker__sheet { height: 58vh; min-height: 310px; } }
