.sheet-host {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
}

.sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--color-overlay);
  animation: sheet-fade-in var(--duration-sheet) var(--ease-standard) both;
}

.sheet {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: var(--space-3) var(--space-5) var(--space-5);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  background: var(--color-surface);
  color: var(--color-text-primary);
  animation: sheet-rise var(--duration-sheet) var(--ease-emphasized) both;
}

.sheet__handle {
  width: var(--size-sheet-handle-width);
  height: var(--size-sheet-handle-height);
  margin: 0 auto var(--space-5);
  border-radius: var(--radius-pill);
  background: var(--color-text-tertiary);
  opacity: 0.55;
}

.sheet__title { margin-bottom: var(--space-5); font-size: var(--font-size-h2); font-weight: var(--font-weight-semibold); line-height: var(--line-height-h2); }
.sheet__body { padding-bottom: var(--space-2); }

@keyframes sheet-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
